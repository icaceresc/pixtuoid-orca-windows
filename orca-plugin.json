{
  "$schema": "https://orca.dev/schemas/orca-plugin.json",
  "manifestVersion": 2,
  "id": "pixtuoid-office",
  "name": "Pixtuoid para Orca",
  "version": "3.0.1",
  "description": "Opens a floating pixel-art office on Windows where your Orca agents, their workers and subagents appear as coworkers: the official Pixtuoid office, or Dungeons & Agents, where clicking an adventurer opens its session in Orca.",
  "author": {
    "name": "icaceresc",
    "url": "https://github.com/icaceresc"
  },
  "repository": "https://github.com/icaceresc/pixtuoid-orca-windows",
  "homepage": "https://github.com/icaceresc/pixtuoid-orca-windows",
  "license": "MIT",
  "engines": {
    "orca": ">=1.4.265"
  },
  "execution": "trusted-worker",
  "main": "plugin/worker.mjs",
  "screenshots": [
    {
      "path": "docs/office.png",
      "alt": "Pixel-art office: Claude Code agents with a Codex and an Antigravity worker, each labelled with its provider, under their Claude parent.",
      "caption": "Cross-provider workers under their Claude Code parent"
    }
  ],
  "contributes": {
    "commands": [
      {
        "id": "pixtuoid.open",
        "title": "Pixtuoid: Open office window"
      },
      {
        "id": "pixtuoid.close",
        "title": "Pixtuoid: Close office window"
      },
      {
        "id": "pixtuoid.install",
        "title": "Pixtuoid: Install or update the office app"
      },
      {
        "id": "pixtuoid.useOffice",
        "title": "Pixtuoid: Use the official Pixtuoid office"
      },
      {
        "id": "pixtuoid.useDungeon",
        "title": "Pixtuoid: Use Dungeons & Agents"
      },
      {
        "id": "pixtuoid.removeData",
        "title": "Pixtuoid: Remove downloaded app and local data"
      }
    ],
    "events": [
      {
        "on": "agent.status.changed"
      }
    ],
    "statusBarItems": [
      {
        "id": "office",
        "text": "Pixtuoid",
        "icon": "bot",
        "tooltip": "Open the Pixtuoid office",
        "command": "pixtuoid.open"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "agent:read"
    },
    {
      "kind": "workspace:read"
    },
    {
      "kind": "workspace:write"
    },
    {
      "kind": "notifications:show"
    }
  ]
}
